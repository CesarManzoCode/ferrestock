# ═══════════════════════════════════════════════════════════════
#  FerreStock — Variables de entorno
#  Copia este archivo como .env y edita los valores
# ═══════════════════════════════════════════════════════════════

# ── Base de datos ──────────────────────────────────────────────
POSTGRES_USER=ferrestock
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=ferrestock_db

# ── Seguridad ──────────────────────────────────────────────────
# Genera una clave segura con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_de_al_menos_32_caracteres

# ── App ────────────────────────────────────────────────────────
# true  → activa /docs de FastAPI y logs SQL (solo desarrollo)
# false → desactiva todo en producción
DEBUG=true

# Días de prueba gratuita para nuevos registros
TRIAL_DAYS=14

# ── Frontend ───────────────────────────────────────────────────
# Desarrollo local:
VITE_API_URL=http://localhost/api/v1
# Producción (nginx rutea /api/ al backend):
# VITE_API_URL=/api/v1
